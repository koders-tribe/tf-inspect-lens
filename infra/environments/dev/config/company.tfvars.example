# cp company.tfvars.example company.tfvars   (gitignored)
# terraform plan -var-file=config/company.tfvars

###############################################################################
# Account / region
###############################################################################

account_id = "<ACCOUNT_ID>"

# Region the existing company resources live in. Every resource in this stack
# is created/read there, so it must match the current stack, not a new choice.
aws_region = "<REGION>"

allow_destroy               = false
secret_recovery_window_days = 30

###############################################################################
# Existing S3 bucket
#
# Set explicitly. If left unset, the name is computed as
# inspect-lens-<environment>-<account_id>-<aws_region>, which differs from the
# existing bucket's name, so Terraform would plan to REPLACE (destroy) it.
###############################################################################

bucket_name = "inspect-lens-demo-dev-<ACCOUNT_ID>-<REGION>-an"

# Frontend origins that PUT/GET S3 via presigned URLs. Required for browser uploads.
cors_allowed_origins = [
  "http://localhost:3000",
  # "https://app.inspect-lens.example.com",
]

###############################################################################
# IAM — app user. Create access keys in the console, not in Terraform.
# Remove AmazonS3FullAccess / AmazonSESFullAccess; the module attaches a scoped policy.
###############################################################################

iam_user_name  = "inspect-lens-dev"
iam_group_name = "inspect-lens-s3-developers"
policy_arns    = []

###############################################################################
# SES — verify mailboxes and/or a domain. Request production access in SES console.
###############################################################################

ses_emails = [
  # "noreply@example.com",
]
ses_domain          = ""
ses_route53_zone_id = ""

###############################################################################
# Feature flags — apply S3/IAM/SES/ECR/OIDC first, then turn these on
###############################################################################

enable_ecr                  = true
enable_github_oidc          = true
create_github_oidc_provider = true
enable_secrets              = true

enable_network       = false
enable_nat_gateway   = false
enable_vpc_endpoints = false
enable_rds           = false
enable_compute       = false
enable_alb           = false

###############################################################################
# When enable_network / enable_rds / enable_compute are true
###############################################################################

# vpc_cidr            = "10.20.0.0/16"
# db_instance_class   = "db.t4g.micro"
# db_name             = "inspect_lens"
# db_username         = "inspect_lens"
# ec2_instance_type   = "t3.small"
# ec2_deploy_path     = "/opt/inspect-lens-be"
# acm_certificate_arn = ""

###############################################################################
# GitHub CD (inspect-lens-be)
###############################################################################

github_org  = "koders-tribe"
github_repo = "inspect-lens-be"
ecr_repository_names = [
  "inspect-lens-be",
  "inspect-image-analyzer",
]
github_deploy_environments = ["staging", "production"]
github_build_allowed_refs  = ["refs/heads/main", "refs/tags/v*"]

tags = {
  Project     = "Inspect Lens"
  Environment = "dev"
  Owner       = "DevOps"
}
